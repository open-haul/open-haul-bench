{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeTheBenchModelOnly",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:__REGION__:__ACCOUNT__:inference-profile/global.anthropic.claude-haiku-5-5",
        "arn:aws:bedrock:*::foundation-model/anthropic.claude-haiku-5-5*"
      ]
    },
    {
      "Sid": "NothingElseEvenIfAnotherPolicyIsAttachedLater",
      "Effect": "Deny",
      "NotAction": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": "*"
    }
  ]
}
